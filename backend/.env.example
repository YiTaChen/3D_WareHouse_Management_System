# Backend runtime
PORT_LOCAL=3002

# Shared API writes require an Authorization: Bearer credential of at least 32 characters.
# Keep the real value in a secret manager/backend environment only; never VITE_* or Git.
# Without it, public reads work and all writes are denied.
# WAREHOUSE_ADMIN_TOKEN=

# DB administration is disabled by default and ALWAYS disabled on Render/production.
# A trusted direct-loopback local admin client needs BOTH this flag and the Bearer token.
# ENABLE_DB_SWITCHER=true

# Optional local PostgreSQL schema alteration only; never applied in production.
# DB_SCHEMA_ALTER=true

# Default no-PostgreSQL demo mode. This stores data in a local SQLite file.
# You can delete backend/data/warehouse.sqlite or run npm run reset:demo to reset it.
DB_ENV=sqlite
SQLITE_STORAGE=data/warehouse.sqlite

# Optional single-value database config. When this is set, it takes priority over
# DB_ENV and is useful for hosted PostgreSQL providers that expose one URL.
# DATABASE_URL=postgres://postgres:postgres@localhost:5432/warehouse_dev

# Legacy split settings are still supported for backward compatibility.
# Use local for a developer machine, cloud for a deployed backend such as Render.
# DB_ENV=local
# DB_ENV=cloud

# Local PostgreSQL example
PG_HOST_LOCAL=localhost
PG_PORT_LOCAL=5432
PG_DATABASE_LOCAL=warehouse_dev
PG_USER_LOCAL=postgres
PG_PASSWORD_LOCAL=postgres
PG_DIALECT_LOCAL=postgres

# Cloud PostgreSQL example
# Keep real cloud database credentials in Render environment variables or
# another secret manager. Do not commit them to GitHub.
PG_HOST=
PG_PORT=5432
PG_DATABASE=
PG_USER=
PG_PASSWORD=
PG_DIALECT=postgres

# Optional. Set this to true only when your hosted PostgreSQL requires SSL.
# PG_SSL=true

# TLS always verifies the PostgreSQL server certificate when PG_SSL=true.
# If your provider uses a private CA, set the PEM certificate in PG_SSL_CA.
# PG_SSL_CA=
